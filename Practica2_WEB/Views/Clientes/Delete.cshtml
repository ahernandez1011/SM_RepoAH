@model Practica2_WEB.Models.Cliente

@{
    ViewData["Title"] = "Eliminar Cliente";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Confirmar Eliminación</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning" role="alert">
                    <strong>¿Está seguro de que desea eliminar este cliente?</strong>
                </div>

                <div class="mb-3">
                    <p><strong>Cédula:</strong> @Model.Cedula</p>
                    <p><strong>Nombre:</strong> @Model.Nombre</p>
                    <p><strong>Correo:</strong> @Model.Correo</p>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="IdCliente" />
                    <div class="row">
                        <div class="col-md-6">
                            <button type="submit" class="btn btn-danger w-100">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>
                        </div>
                        <div class="col-md-6">
                            <a asp-action="Index" class="btn btn-secondary w-100">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
