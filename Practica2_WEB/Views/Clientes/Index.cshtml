@model List<Practica2_WEB.Models.Cliente>

@{
    ViewData["Title"] = "Listado de Clientes";
}

<div class="row">
    <div class="col-md-12">
        <h2>Gestión de Clientes</h2>
        <hr />

        @if (Model?.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Cédula</th>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cliente in Model)
                        {
                            <tr>
                                <td>@cliente.Cedula</td>
                                <td>@cliente.Nombre</td>
                                <td>@cliente.Correo</td>
                                <td>
                                    @if (cliente.Estado)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@cliente.IdCliente" class="btn btn-sm btn-primary">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@cliente.IdCliente" class="btn btn-sm btn-danger">Eliminar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info" role="alert">
                No hay clientes registrados. <a asp-action="Create">Registrar un cliente</a>
            </div>
        }

        <div class="mt-3">
            <a asp-action="Create" class="btn btn-success">Registrar Nuevo Cliente</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Volver</a>
        </div>
    </div>
</div>
