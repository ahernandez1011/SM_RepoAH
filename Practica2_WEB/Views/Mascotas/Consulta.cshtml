@model List<Practica2_WEB.Models.Mascota>

@{
    ViewData["Title"] = "Consulta de Mascotas";
}

<div class="row">
    <div class="col-md-12">
        <h2>Consulta de Mascotas Registradas</h2>
        <hr />

        @if (Model?.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Cédula del Cliente</th>
                            <th>Nombre del Cliente</th>
                            <th>Nombre de la Mascota</th>
                            <th>Especie</th>
                            <th>Peso (kg)</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mascota in Model)
                        {
                            <tr>
                                <td><strong>@mascota.ClienteCedula</strong></td>
                                <td>@mascota.ClienteNombre</td>
                                <td>@mascota.Nombre</td>
                                <td>@mascota.Especie</td>
                                <td>@mascota.Peso.ToString("F2")</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@mascota.IdMascota" class="btn btn-sm btn-primary">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@mascota.IdMascota" class="btn btn-sm btn-danger">Eliminar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info" role="alert">
                No hay mascotas registradas. <a asp-action="Create">Registrar una mascota</a>
            </div>
        }

        <div class="mt-3">
            <a asp-action="Create" class="btn btn-success">Registrar Nueva Mascota</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Volver</a>
        </div>
    </div>
</div>
