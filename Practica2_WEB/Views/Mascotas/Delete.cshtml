@model Practica2_WEB.Models.Mascota

@{
    ViewData["Title"] = "Eliminar Mascota";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Confirmar Eliminación</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning" role="alert">
                    <strong>¿Está seguro de que desea eliminar esta mascota?</strong>
                </div>

                <div class="mb-3">
                    <p><strong>Cédula del Cliente:</strong> @Model.ClienteCedula</p>
                    <p><strong>Nombre del Cliente:</strong> @Model.ClienteNombre</p>
                    <p><strong>Nombre Mascota:</strong> @Model.Nombre</p>
                    <p><strong>Especie:</strong> @Model.Especie</p>
                    <p><strong>Raza:</strong> @Model.Raza</p>
                    <p><strong>Peso:</strong> @Model.Peso.ToString("F2") kg</p>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="IdMascota" />
                    <div class="row">
                        <div class="col-md-6">
                            <button type="submit" class="btn btn-danger w-100">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>
                        </div>
                        <div class="col-md-6">
                            <a asp-action="Consulta" class="btn btn-secondary w-100">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
