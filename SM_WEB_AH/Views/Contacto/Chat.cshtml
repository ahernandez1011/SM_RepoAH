@model List<SolicitudChatModel>

@{
    var urlApi = ViewBag.UrlApi as string;
}

<div class="row g-0" style="height: calc(100vh - 180px); min-height: 500px;">

    <!-- Panel izquierdo: lista de solicitudes -->
    <div class="col-12 col-md-4 col-lg-3 border-end d-flex flex-column">
        <div class="p-3 border-bottom">
            <h5 class="mb-0"><i class="bi bi-chat-dots me-2"></i>Conversaciones</h5>
        </div>
        <div class="overflow-auto flex-grow-1" id="listaSolicitudes">
            @if (!Model.Any())
            {
                <p class="text-muted text-center mt-4 px-3">No hay solicitudes abiertas actualmente.</p>
            }
            @foreach (var s in Model)
            {
                <div class="solicitud-item p-3 border-bottom cursor-pointer"
                     data-consecutivo="@s.Consecutivo"
                     data-interlocutor="@s.NombreInterlocutor">
                    <div class="fw-semibold text-truncate">@s.Titulo</div>
                    <small class="text-muted">@s.NombreInterlocutor</small>
                </div>
            }
        </div>
    </div>

    <!-- Panel derecho: ventana de chat -->
    <div class="col-12 col-md-8 col-lg-9 d-flex flex-column h-100">

        <!-- Cabecera de la sala -->
        <div class="p-3 border-bottom d-flex align-items-center" id="chatHeader" style="display:none!important;">
            <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center me-3"
                 style="width:38px;height:38px;min-width:38px;">
                <i class="bi bi-person-fill text-white"></i>
            </div>
            <div>
                <div class="fw-semibold" id="chatNombreInterlocutor">—</div>
                <small class="text-success" id="chatEstadoConexion">Conectando…</small>
            </div>
        </div>

        <!-- Área de mensajes -->
        <div class="flex-grow-1 overflow-auto p-3 bg-light" id="areaMensajes">
            <p class="text-muted text-center mt-5" id="chatPlaceholder">
                Selecciona una conversación para comenzar.
            </p>
        </div>

        <!-- Caja de envío -->
        <div class="p-3 border-top" id="cajaEnvio">
            <div class="input-group">
                <input type="text" id="inputMensaje" class="form-control" disabled
                       placeholder="Selecciona una conversación…" autocomplete="off" maxlength="2000">
                <button class="btn btn-primary" id="btnEnviar" disabled>
                    <i class="bi bi-arrow-up"></i>
                </button>
            </div>
        </div>

    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
    const jwtToken = '@ViewBag.Token';
    const consecutivoActual = @ViewBag.ConsecutivoUsuario;
    const urlHub = '@ViewBag.UrlHub';
</script>
<script src="~/js/chat.js" asp-append-version="true"></script>