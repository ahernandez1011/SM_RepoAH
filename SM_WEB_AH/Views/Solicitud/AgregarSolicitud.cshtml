@model SolicitudModel

<form id="AgregarSolicitudForm" asp-action="AgregarSolicitud" asp-controller="Solicitud"
      method="post" enctype="multipart/form-data">

    <div class="row align-items-stretch">
        <div class="col-12 col-lg-6 d-flex">
            <div class="card h-100 w-100">
                <div class="card-body">

                    <div class="page-title mb-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <h3>Agregar Solicitud</h3>
                        </div>
                    </div>

                    @if (ViewBag.Mensaje != null)
                    {
                        <div class="alert alert-@ViewBag.ClaseMensaje text-center">
                            @ViewBag.Mensaje
                        </div>
                    }

                    <div class="col form-group">
                        <label for="Titulo" class="form-label">Título</label>
                        <input asp-for="Titulo" type="text" class="form-control">
                    </div>

                    <div class="col form-group">
                        <label for="Descripcion" class="form-label">Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control" rows="5"></textarea>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">Procesar</button>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6 d-flex">
            <div class="card h-100 w-100">
                <div class="card-body d-flex flex-column">

                    <div id="zonaPDF" class="zona-imagen d-flex flex-column align-items-center justify-content-center flex-grow-1"
                         onclick="document.getElementById('inputPDF').click()">
                        <span id="textoPDF" class="text-muted mt-2">Haga clic para seleccionar un PDF</span>
                        <embed id="previstaPDF" src="#" type="application/pdf" class="previa-imagen d-none" />
                    </div>

                    <input type="file" id="inputPDF" name="Imagen" accept="application/pdf" class="d-none"
                           onchange="previsualizarPDF(this)" />
                </div>
            </div>
        </div>
    </div>

</form>

<script src="~/js/agregarSolicitud.js" asp-append-version="true"></script>